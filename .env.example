# StrandsOps — on-call SRE helper configuration
# Copy this file to .env and configure your environment.

# ==============================================================================
# Model Provider Configuration
# ==============================================================================

# Option 1: Amazon Bedrock (RECOMMENDED - Uses AWS Credits)
MODEL_PROVIDER=bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 12-digit account id (optional; used in Streamlit/CLI badges)
AWS_ACCOUNT_ID=
# Common Bedrock Model IDs:
# Claude 3.5 Sonnet: anthropic.claude-3-5-sonnet-20240620-v1:0 (or cross-region us.anthropic.claude-3-5-sonnet-20240620-v1:0)
# Claude 3 Haiku: anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20240620-v1:0

# Option 2: OpenAI (Alternative)
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=your-key-here
# OPENAI_MODEL=gpt-4o

# Option 3: Ollama (100% Free / Fully Offline / Local)
# MODEL_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ==============================================================================
# Cloud Simulation & SRE Guardrails
# ==============================================================================
# Backend for tools: 'simulator' (default, chaos lab works) or 'aws'
# (LiveAWSProvider — CloudWatch/ECS/SQS; chaos inject not available)
CLOUD_BACKEND=simulator

# Safety gate: require human approval if blast radius exceeds this many
# direct dependent services (used by analyze_blast_radius)
AUTO_REMEDIATE_BLAST_LIMIT=2

# Maximum instances that can be added/removed in a single scale_service call
MAX_SCALE_DELTA=5

# SLA targets — read by verification and telemetry tools
SLA_MAX_P99_LATENCY_MS=120
SLA_MAX_ERROR_RATE_PERCENT=1.0

# Optional live AWS resource targets (only when CLOUD_BACKEND=aws)
# AWS_ECS_CLUSTER=prod-cluster
# AWS_SQS_QUEUE_URL=
# AWS_SQS_DLQ_URL=
# AWS_CLOUDWATCH_LOG_GROUP=/aws/ecs/strandops-services

# ==============================================================================
# Optional faster model for light triage (when using Bedrock)
# ==============================================================================
BEDROCK_TRIAGE_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# BEDROCK_MODEL_ID is set above in the Model Provider section
